{
    "typeCheckingMode": "basic",
    "exclude": [
        "**/.nox/**",
        "**/.venv/**",
        "**/dist-packages/**",
        "**/dist_vercel/.vercel/**",
        "**/dist_native/**",
        "**/site-packages/**",
    ],
    "ignore": [
        "**/third_party/**",
        "dist/**",
        "dist_vercel/**",
        "dist_native/**",
        "template/**",
        "tests/**",
        "codegen/**",
        "src/aignostics/wsi/_pydicom_handler.py",
        "src/aignostics/notebook/_notebook.py",
    ],
    "extraPaths": [
        "./src/aignostics/utils/_"
    ]
}