      ],
      "port": 8802
    },
    {
      "name": "launchpad-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "AIGNOSTICS_API_ROOT=https://platform-dev.aignostics.ai uv run aignostics system serve --host 127.0.0.1 --port 8803"
      ],
      "port": 8803
    }
  ]
